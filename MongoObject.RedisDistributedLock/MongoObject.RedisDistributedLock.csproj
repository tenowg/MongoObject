  <PackageReference Include="Tenowg.MongoObjects" Version="$(DUMB_HACK)" Condition="'$(IsPacking)' == 'true'" /> -->
      <!-- <ProjectReference Include="..\MongoObject.Core\MongoObject.Core.csproj">
      <PackageVersion>$(DUMB_HACK)</PackageVersion>
    </ProjectReference> -->
  </ItemGroup>

</Project>
