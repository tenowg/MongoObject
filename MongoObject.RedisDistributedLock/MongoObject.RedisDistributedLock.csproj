<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
  </ItemGroup> -->

  <ItemGroup>
    <!-- TreatAsPackageReference=false prevents NuGet from auto-generating the dependency -->
  <ProjectReference Include="..\MongoObject.Core\MongoObject.Core.csproj" TreatAsPackageReference="false" />
  
  <!-- This explicitly maps the dependency cleanly using your MinVer variable -->
  <PackageReference Include="Tenowg.MongoObjects" Version="$(MINVERVERSIONOVERRIDE)" />
