{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../MongoObject.Core",
          "files": [
            "**/*.csproj"
          ]
        },
        {
          "src": "../MongoObject.MongoDistributedLock",
          "files": [
            "**/*.csproj"
          ]
        },
        {
          "src": "../MongoObject.RedisDistributedLock",
          "files": [
            "**/*.csproj"
          ]
        },
        {
          "src": "../MongoObject.PropertyEncryption",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "output": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "noRestore": false,
      "namespaceLayout": "flattened",
      "memberLayout": "samePage",
      "allowCompilationErrors": false
    },
    {
      "src": [
        { 
          "files": [
            "**/*.csproj"
          ], 
          "src": "../MongoObject.Core" 
        }
      ],
      "output": "_site/llm-api",
      "includePrivateMembers": true,
      "outputFormat": "markdown",
      "namespaceLayout": "flattened",
      "memberLayout": "samePage"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": [
      "default",
      "modern"
    ],
    "postProcessors": [],
    "keepFileLink": false,
    "disableGitFeatures": false,
    "globalMetadata": {
      "_appName": "MongoObject",
      "_appTitle": "MongoObject Documentation",
      "_appFooter": "<span>MongoObject - A modern MongoDB ODM for .NET 10</span>",
      "_appLogoPath": "images/mongooptions-64.webp",
      "_appFaviconPath": "images/favicon.ico",
      "_enableSearch": true,
      "_enableNewTab": true,
      "_gitContribute": {
        "repo": "https://github.com/tenowg/MongoObjects",
        "branch": "main"
      }
    }
  }
}